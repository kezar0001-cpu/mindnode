NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (server-only, never NEXT_PUBLIC_)
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# Per-task model overrides. Leave blank to fall back to AI_PROVIDER_MODEL
# and then to per-task defaults. The router resolves these in models.ts.
AI_MODEL_DOCUMENT_GRAPH=
AI_MODEL_DOCUMENT_GRAPH_FAST=
AI_MODEL_GHOST_EXPLORE=
AI_MODEL_DEEP_EXPLORE=
AI_MODEL_CHAT=
AI_MODEL_CHAT_SUMMARY=

# Embeddings for hybrid retrieval. Must produce 1536-dim vectors — the
# dimensions parameter is pinned to 1536 to match the vector(1536) columns.
# Defaults to text-embedding-3-small.
AI_EMBEDDING_MODEL=

# Per-attempt timeout for AI provider calls (chat + embeddings), in
# milliseconds. Defaults to 30000. Transient failures (429/5xx/network)
# retry up to 3 attempts with exponential backoff.
AI_REQUEST_TIMEOUT_MS=
